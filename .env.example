# Optional: absolute path to the demo ledger config (defaults to <repo>/.oled/config.json)
# OLED_CONFIG="/abs/path/to/.oled/config.json"

# Optional: any OpenAI-compatible endpoint for AI features (OpenLedger CFO chat); absent = rules-only mode
# OPENAI_COMPATIBLE_BASE_URL="https://api.your-gateway.com/v1"
# OPENAI_COMPATIBLE_API_KEY="sk-..."   (keyless local endpoints accept any string)
# OPENAI_COMPATIBLE_MODEL="openai/gpt-5.6-luna"
