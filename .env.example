# Control plane (docker postgres with a database named cfo)
POSTGRES_URL="postgres://postgres:postgres@127.0.0.1:5432/cfo"

# Optional: absolute path to the demo ledger config (defaults to <repo>/.oled/config.json)
# OLED_CONFIG="/abs/path/to/.oled/config.json"


# Optional: OpenRouter for AI features (Corgi CFO chat); absent = rules-only mode
# OPENROUTER_API_KEY="sk-or-..."
# OPENROUTER_MODEL="openai/gpt-5.6-luna"
