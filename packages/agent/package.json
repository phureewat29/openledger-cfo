{
  "name": "@openledger-cfo/agent",
  "description": "The cfo and ingest agents: personas, ledger tools, and the stream bridge",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./sanitize": "./src/sanitize.ts",
    "./catalog": "./src/catalog.ts"
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "probe": "pnpm with-env tsx scripts/probe.ts",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/langgraph-sdk": "^1.9.29",
    "@langchain/openai": "^1.5.6",
    "@openledger-cfo/api": "workspace:*",
    "@openledger-cfo/openledger": "workspace:*",
    "ai": "catalog:",
    "deepagents": "^1.12.2",
    "langchain": "^1.5.5",
    "langsmith": "^0.7.17",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@openledger-cfo/eslint-config": "workspace:*",
    "@openledger-cfo/prettier-config": "workspace:*",
    "@openledger-cfo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@openledger-cfo/prettier-config"
}
